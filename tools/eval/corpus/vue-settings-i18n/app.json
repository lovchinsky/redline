      "expect": ["src/components/NotificationToggles.vue"]
    },
    { "id": "two-factor", "circle": "#security", "expect": ["src/components/SecurityCard.vue"] },
    {
      "id": "delete-account",
      "circle": "button.danger-button",
      "expect": ["src/components/DangerZone.vue"]
    },
    {
      "id": "danger-zone",
      "circle": "section.danger-zone",
      "expect": ["src/components/DangerZone.vue"]
    }
  ]
}
