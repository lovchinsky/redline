{
  "name": "@redline/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "wxt build && wxt build --mode e2e && playwright test"
  },
  "dependencies": {
    "@redline/assembly": "workspace:*",
    "@redline/capture": "workspace:*",
    "@redline/contract": "workspace:*",
    "@redline/core": "workspace:*",
    "@redline/dom": "workspace:*",
    "@redline/geometry": "workspace:*",
    "@redline/modules": "workspace:*",
    "@redline/page-runtime": "workspace:*",
    "@redline/pipeline": "workspace:*",
    "@redline/processors": "workspace:*",
    "@redline/profiles": "workspace:*",
    "@redline/rpc": "workspace:*",
    "fflate": "^0.8",
    "idb": "^8",
    "lucide-preact": "^1",
    "preact": "^11",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@babel/core": "^7",
    "@playwright/test": "^1",
    "@preact/preset-vite": "^2",
    "@redline/mock-receiver": "workspace:*",
    "@vitest/browser-playwright": "^5",
    "fake-indexeddb": "^6",
    "playwright": "^1",
    "typescript": "~5.9",
    "vitest": "^5",
    "vue": "^3",
    "wxt": "^0.21"
  }
}
