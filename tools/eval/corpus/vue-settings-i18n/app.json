{
  "framework": "vue",
  "styling": "scoped-css",
  "i18n": true,
  "cases": [
    { "id": "nav", "circle": "nav.settings-nav", "expect": ["src/components/SettingsNav.vue"] },
    {
      "id": "profile-save",
