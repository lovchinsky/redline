{
  "name": "redline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "pnpm --filter @redline/extension dev",
    "build": "pnpm --filter @redline/extension build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:boundaries:selftest": "node scripts/verify-boundaries.mjs",
    "depcruise": "depcruise packages apps/extension/src apps/receiver/src apps/agent-host/src --config .dependency-cruiser.cjs",
    "depcruise:selftest": "node scripts/verify-depcruise.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @redline/receiver test:integration",
    "test:e2e": "pnpm --filter @redline/extension test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm lint:boundaries:selftest && pnpm depcruise && pnpm depcruise:selftest && pnpm typecheck && pnpm test",
    "eval": "pnpm --filter @redline/eval eval",
    "budgets": "node scripts/check-budgets.mjs",
    "package": "pnpm build && node scripts/pack-extension.mjs && node scripts/verify-store-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^22",
    "dependency-cruiser": "^18",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-boundaries": "^7",
    "eslint-plugin-react-hooks": "^7",
    "fflate": "^0.8",
    "globals": "^17",
    "prettier": "^3",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vitest": "^5"
  }
}
